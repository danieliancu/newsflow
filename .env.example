DJANGO_SECRET_KEY=replace-with-a-long-random-secret
APP_PUBLIC_URL=http://127.0.0.1:8000
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production example:
# APP_PUBLIC_URL=https://newsflow.example
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=newsflow.example,www.newsflow.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://newsflow.example,https://www.newsflow.example
# PUBLIC_CONTACT_EMAIL=office@newsflow.ro
# GOOGLE_ANALYTICS_ID=G-DDT1Z5SD9L
# DEFAULT_FROM_EMAIL=Newsflow <office@newsflow.ro>

# Pentru producție / Resend SMTP:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=replace-with-your-resend-api-key
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Newsflow <no-reply@example.com>

# Clasificare AI (rulează doar pentru știrile rămase fără categorie)
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_CLASSIFICATION_ENABLED=true
OPENAI_CLASSIFICATION_MODEL=gpt-5.4-nano
OPENAI_INPUT_USD_PER_MILLION=0.20
OPENAI_CACHED_INPUT_USD_PER_MILLION=0.02
OPENAI_OUTPUT_USD_PER_MILLION=1.25
OPENAI_USD_TO_GBP_RATE=0.7525
OPENAI_CLASSIFICATION_AUTO_THRESHOLD=0.80
OPENAI_EVENT_EXTRACTION_MODEL=gpt-5.4-nano
OPENAI_EVENT_SUMMARY_MODEL=gpt-5.4-mini
OPENAI_EVENT_NANO_INPUT_USD_PER_MILLION=0.20
OPENAI_EVENT_NANO_CACHED_INPUT_USD_PER_MILLION=0.02
OPENAI_EVENT_NANO_OUTPUT_USD_PER_MILLION=1.25
OPENAI_EVENT_MINI_INPUT_USD_PER_MILLION=0.75
OPENAI_EVENT_MINI_CACHED_INPUT_USD_PER_MILLION=0.075
OPENAI_EVENT_MINI_OUTPUT_USD_PER_MILLION=4.50
NEWSFLOW_EVENT_ACTIVE_DAYS=7
NEWSFLOW_EVENT_REGENERATION_MINUTES=60
NEWSFLOW_EVENT_ESTIMATED_RESERVATION_GBP=0.010
NEWSFLOW_AUTOMATIC_LOCK_TIMEOUT_MINUTES=120
NEWSFLOW_EVENT_EXCLUDED_SOURCE_SLUGS=gandul
NEWSFLOW_CONNECT_TIMEOUT=5
NEWSFLOW_READ_TIMEOUT=10
NEWSFLOW_MAX_FEED_BYTES=5242880
NEWSFLOW_MAX_PAGE_BYTES=3145728
NEWSFLOW_MAX_IMAGE_BYTES=3145728
TIME_ZONE=Europe/London
